using System;
using System.Collections.Generic; using System.Linq;
using System.Text;

namespace JaggedArray
{
class Program
{
static void Main(string[] args)
{
int[][] jagarray = new int[4][]; 

for (int i = 0; i <4; i++)
{
Console.WriteLine("enter the size of array at {0} ", (i + 1)); int j = Convert.ToInt32(Console.ReadLine());
jagarray[i] = new int[j];
}

for (int i = 0; i <= 3; i++)
{
Console.WriteLine("enter the elements of the array at {0}", (i + 1)); for (int j = 0; j <jagarray[i].Length; j++)
{
jagarray[i][j] = Convert.ToInt32(Console.ReadLine());
}

}


Console.WriteLine("output:"); for (int i = 0; i < 4; i++)
{
Console.WriteLine("The elements of the array at {0}", i + 1); for (int j = 0; j <jagarray[i].Length; j++)
{
Console.WriteLine(jagarray[i][j]);
}
}
Console.ReadKey();

}
}
}

